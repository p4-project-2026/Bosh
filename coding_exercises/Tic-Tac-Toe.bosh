#Tic-Tac-Toe Game in Bosh

#Function to clear the terminal
function ClearScreen:
    execute "cls"

#Start Screen
run ClearScreen
print "  ╔═══════════════════════════════╗" .
print "  ║      TIC-TAC-TOE IN BOSH      ║" .
print "  ╠═══════════════════════════════╣" .
print "  ║  SELECT GAME MODE             ║" .
print "  ║                               ║" .
print "  ║  [1]  Play 1 Player (vs AI)   ║" .
print "  ║  [2]  Play 2 Player           ║" .
print "  ╚═══════════════════════════════╝" .
print ""
GameMode is input "  Enter your choice (1 or 2): "

#Initialize variables
IsAI is false
AIType is "perfect"
CurrentPlayer is "X"

#If 1 player, choose AI type
if GameMode == "1":
    run ClearScreen
    IsAI is true
    print "  ╔═══════════════════════════════╗"
    print "  ║      TIC-TAC-TOE IN BOSH      ║"
    print "  ╠═══════════════════════════════╣"
    print "  ║  Choose Difficulty            ║"
    print "  ║  [1]  Easy                    ║"
    print "  ║  [2]  Hard                    ║"
    print "  ╚═══════════════════════════════╝"
    print ""
    AIChoice is input "  Enter your choice (1 or 2): "
    if AIChoice == "1":
        AIType is "random"
    else:
        AIType is "perfect"
    
    #Randomly decide who goes first
    WhoFirst is random from 1 to 2
    if WhoFirst == 1:
        CurrentPlayer is "X"
    else:
        CurrentPlayer is "O"

#Initialize the board with empty spaces
Board is a list
count from 1 to 9:
    append " " to Board


#Function to print the board
function PrintBoard:
    run ClearScreen
    print "  ╔═══════════════════════════════╗"
    print "  ║      TIC-TAC-TOE IN BOSH      ║"
    if IsAI == true:
        print "  ╠═══╦═══╦═══╦═══════════════════╣"
        print "  ║ {Board at 0} ║ {Board at 1} ║ {Board at 2} ║  Current: {CurrentPlayer}       ║"
        print "  ╠═══╬═══╬═══╣                   ║"
        print "  ║ {Board at 3} ║ {Board at 4} ║ {Board at 5} ║  (X = You)        ║"
        print "  ╠═══╬═══╬═══╣  (O = AI)         ║"
        print "  ║ {Board at 6} ║ {Board at 7} ║ {Board at 8} ║                   ║"
        print "  ╚═══╩═══╩═══╩═══════════════════╝"
    else:
        print "  ╠═══╦═══╦═══╦═══════════════════╣"
        print "  ║ {Board at 0} ║ {Board at 1} ║ {Board at 2} ║  Current: {CurrentPlayer}       ║"
        print "  ╠═══╬═══╬═══╣                   ║"
        print "  ║ {Board at 3} ║ {Board at 4} ║ {Board at 5} ║  (X = Player 1)   ║"
        print "  ╠═══╬═══╬═══╣  (O = Player 2)   ║"
        print "  ║ {Board at 6} ║ {Board at 7} ║ {Board at 8} ║                   ║"
        print "  ╚═══╩═══╩═══╩═══════════════════╝"

#Function to check if a player has won
function CheckWinner uses (Player):
    #Check rows
    if Board at 0 == Player and Board at 1 == Player and Board at 2 == Player:
        return true
    if Board at 3 == Player and Board at 4 == Player and Board at 5 == Player:
        return true
    if Board at 6 == Player and Board at 7 == Player and Board at 8 == Player:
        return true
    
    #Check columns
    if Board at 0 == Player and Board at 3 == Player and Board at 6 == Player:
        return true
    if Board at 1 == Player and Board at 4 == Player and Board at 7 == Player:
        return true
    if Board at 2 == Player and Board at 5 == Player and Board at 8 == Player:
        return true
    
    #Check diagonals
    if Board at 0 == Player and Board at 4 == Player and Board at 8 == Player:
        return true
    if Board at 2 == Player and Board at 4 == Player and Board at 6 == Player:
        return true
    
    return false

#Function to check if board is full (draw)
function IsDraw:
    IsFull is true
    count I from 0 to 8:
        if Board at I == " ":
            IsFull is false
    return IsFull

#Function to check if position creates a win
function CanWin uses (Position, Player):
    Board at Position is Player
    Result is CheckWinner result using (Player)
    Board at Position is " "
    return Result

#Function for Random AI
function AIRandomMove:
    Position is 0
    ValidMove is false
    repeat until ValidMove == true:
        Position is random from 0 to 8
        if Board at Position == " ":
            Board at Position is "O"
            ValidMove is true

#Function for Perfect AI
function AIPerfectMove:
    MoveMade is false
    
    #1. Try to win
    if MoveMade == false:
        WinningPos is -1
        count I from 0 to 8:
            if Board at I == " ":
                if CanWin result using (I, "O"):
                    WinningPos is I
        if WinningPos != -1:
            Chance is random from 1 to 100
            if Chance > 20:
                Board at WinningPos is "O"
                MoveMade is true
    
    #2. Block player from winning
    if MoveMade == false:
        BlockingPos is -1
        count I from 0 to 8:
            if Board at I == " ":
                if CanWin result using (I, "X"):
                    BlockingPos is I
        if BlockingPos != -1:
            Chance is random from 1 to 100
            if Chance > 10:
                Board at BlockingPos is "O"
                MoveMade is true
    
    #3. Take center if available
    if MoveMade == false and Board at 4 == " ":
        Board at 4 is "O"
        print "AI chose position 5" .
        MoveMade is true
    
    #4. Take corners (randomized)
    if MoveMade == false:
        ChosenCorner is -1
        Corners is [0, 2, 6, 8]
        count I from 0 to 3:
            Corner is Corners at I
            if ChosenCorner == -1 and Board at Corner == " ":
                Chance is random from 1 to 100
                if Chance > 50:
                    ChosenCorner is Corner
        if ChosenCorner != -1:
            Board at ChosenCorner is "O"
            MoveMade is true
    
    #5. Take any available space
    if MoveMade == false:
        count I from 0 to 8:
            if MoveMade == false and Board at I == " ":
                Board at I is "O"
                MoveMade is true

#Main AI move dispatcher
function AIMove:
    if AIType == "random":
        run AIRandomMove
    else:
        run AIPerfectMove

#Main game loop
repeat until false:
    run PrintBoard
    
    #Check if AI should play
    if CurrentPlayer == "O" and IsAI == true:
        run AIMove
        wait 0.5 second
    else:
        #Get player input
        print ""
        MoveInput is input "  Player {CurrentPlayer}, enter position (1-9): "
        
        #Convert input to index (1-based to 0-based)
        MoveLocation is MoveInput as int - 1
        
        #Validate position range
        if MoveLocation < 0 or MoveLocation > 8:
            continue
        
        #Check if position is already taken
        if Board at MoveLocation != " ":
            continue
        
        #Place the move
        Board at MoveLocation is CurrentPlayer
    
    #Check for winner
    if CheckWinner result using (CurrentPlayer):
        run PrintBoard
        if CurrentPlayer == "O" and IsAI == true:
            print "  ╔═══════════════════════════════╗" .
            print "  ║           AI WINS!            ║" .
            print "  ╚═══════════════════════════════╝" .
        if CurrentPlayer == "X" and IsAI == true:
            print "  ╔═══════════════════════════════╗" .
            print "  ║           You WIN!            ║" .
            print "  ╚═══════════════════════════════╝" .
        if IsAI == false:
            print "  ╔═══════════════════════════════╗" .
            print "  ║        Player {CurrentPlayer} WINS!         ║" .
            print "  ╚═══════════════════════════════╝" .
        break
    
    #Check for draw
    if IsDraw result:
        run PrintBoard
        print "  ╔═══════════════════════════════╗" .
        print "  ║         IT'S A DRAW!          ║" .
        print "  ╚═══════════════════════════════╝" .
        break
    
    #Switch player
    if CurrentPlayer == "X":
        CurrentPlayer is "O"
    else:
        CurrentPlayer is "X"
