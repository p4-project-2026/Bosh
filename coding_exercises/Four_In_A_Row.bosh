# Four in a Row (Connect Four) Game
# Players take turns dropping pieces, first to get 4 in a row wins

# Initialize the board (6 rows x 7 columns)
# 0 = empty, 1 = player 1, 2 = player 2
function Create Board:
    Board is a list
    count Row from 1 to 6:
        Row List is a list
        count Col from 1 to 7:
            append 0 to Row List
        append Row List to Board
    return Board

# Display the current board state
function Print Board uses (Board):
    print ""
    print "  1 2 3 4 5 6 7"
    print "+-+-+-+-+-+-+-+"
    
    count Row from 1 to 6:
        Row Index is Row - 1
        Current Row is Board at Row Index
        Line is "|"
        count Col from 1 to 7:
            Col Index is Col - 1
            Cell is Current Row at Col Index
            if Cell == 0:
                Line is Line + " "
            else:
                if Cell == 1:
                    Line is Line + "X"
                else:
                    Line is Line + "O"
            Line is Line + "|"
        print Line
    
    print "+-+-+-+-+-+-+-+"
    print ""

# Get the next available row for a column (or -1 if full)
function Get_Drop_Row uses (Board, Column):
    Col_Index is Column - 1
    count Row from 6 to 1:
        Row_Index is Row - 1
        Row_Data is Board at Row_Index
        Cell is Row_Data at Col_Index
        if Cell == 0:
            return Row
    return -1

# Check if there's a winner
function Check_Winner uses (Board, Player):
    # Check horizontal
    count Row from 1 to 6:
        Row_Index is Row - 1
        Row_Data is Board at Row_Index
        count Col from 1 to 4:
            Col_Index is Col - 1
            if (Row_Data at Col_Index) == Player and (Row_Data at (Col_Index + 1)) == Player and (Row_Data at (Col_Index + 2)) == Player and (Row_Data at (Col_Index + 3)) == Player:
                return true
    
    # Check vertical
    count Col from 1 to 7:
        Col_Index is Col - 1
        count Row from 1 to 3:
            Row_Index is Row - 1
            Row1 is Board at Row_Index
            Row2 is Board at (Row_Index + 1)
            Row3 is Board at (Row_Index + 2)
            Row4 is Board at (Row_Index + 3)
            
            Cell1 is Row1 at Col_Index
            Cell2 is Row2 at Col_Index
            Cell3 is Row3 at Col_Index
            Cell4 is Row4 at Col_Index
            
            if Cell1 == Player and Cell2 == Player and Cell3 == Player and Cell4 == Player:
                return true
    
    # Check diagonal (down-right)
    count Row from 1 to 3:
        Row_Index is Row - 1
        count Col from 1 to 4:
            Col_Index is Col - 1
            Row1 is Board at Row_Index
            Row2 is Board at (Row_Index + 1)
            Row3 is Board at (Row_Index + 2)
            Row4 is Board at (Row_Index + 3)
            
            Cell1 is Row1 at Col_Index
            Cell2 is Row2 at (Col_Index + 1)
            Cell3 is Row3 at (Col_Index + 2)
            Cell4 is Row4 at (Col_Index + 3)
            
            if Cell1 == Player and Cell2 == Player and Cell3 == Player and Cell4 == Player:
                return true
    
    # Check diagonal (up-right)
    count Row from 4 to 6:
        Row_Index is Row - 1
        count Col from 1 to 4:
            Col_Index is Col - 1
            Row1 is Board at Row_Index
            Row2 is Board at (Row_Index - 1)
            Row3 is Board at (Row_Index - 2)
            Row4 is Board at (Row_Index - 3)
            
            Cell1 is Row1 at Col_Index
            Cell2 is Row2 at (Col_Index + 1)
            Cell3 is Row3 at (Col_Index + 2)
            Cell4 is Row4 at (Col_Index + 3)
            
            if Cell1 == Player and Cell2 == Player and Cell3 == Player and Cell4 == Player:
                return true
    
    return false

# Check if board is full
function Is_Board_Full uses (Board):
    count Row from 1 to 6:
        Row_Index is Row - 1
        Row_Data is Board at Row_Index
        count Col from 1 to 7:
            Col_Index is Col - 1
            Cell is Row_Data at Col_Index
            if Cell == 0:
                return false
    return true

# Main game loop
print "Welcome to Four in a Row!"
print "X = Player 1, O = Player 2"
print ""

Board is Create_Board result
Current_Player is 1
Game_Over is false

repeat until Game_Over:
    run Print_Board using (Board)
    
    if Current_Player == 1:
        print "Player 1's turn (X)"
        Symbol is "X"
    else:
        print "Player 2's turn (O)"
        Symbol is "O"
    
    Column is input "Enter column (1-7): "
    Col_Num is Column as int
    
    if Col_Num < 1 or Col_Num > 7:
        print "Invalid column! Please enter 1-7."
        continue
    
    Drop_Row is Get_Drop_Row result using (Board, Col_Num)
    
    if Drop_Row == -1:
        print "Column is full! Choose another column."
        continue
    
    Row_Index is Drop_Row - 1
    Col_Index is Col_Num - 1
    Row_Data is Board at Row_Index
    Row_Data at Col_Index is Current_Player
    
    # Check for winner
    if Check_Winner result using (Board, Current_Player):
        run Print_Board using (Board)
        print "Player {Current_Player} wins with {Symbol}!"
        Game_Over is true
    else:
        if Is_Board_Full result using (Board):
            run Print_Board using (Board)
            print "Board is full! It's a draw."
            Game_Over is true
        else:
            # Switch player
            if Current_Player == 1:
                Current_Player is 2
            else:
                Current_Player is 1

print "Game Over!"
