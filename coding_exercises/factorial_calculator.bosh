N is 0
function Factorial:
    if N < 0: 
        say "Factorial does not exist for negative numbers"
        quit
    
    if N == 0 or N == 1:
        return 1
    else:
        Result is 1
        count I from 2 to N
            Result is Result * I
        return Result
        

# Take input from user
Input is input "Enter a number: "
N is Input as int

print "Factorial of " + N + " is " + Factorial result